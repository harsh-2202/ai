import random

def get_conflicts(board):
    """Counts total pairs of attacking queens."""
    n = len(board)
    conflicts = 0
    for i in range(n):
        for j in range(i + 1, n):
            # Check if they share the same row or the same diagonal
            if board[i] == board[j] or abs(board[i] - board[j]) == j - i:
                conflicts += 1
    return conflicts

def hill_climbing_n_queens(n, max_restarts=500):
    """Solves N-Queens using Hill Climbing with random restarts."""
    for restart in range(max_restarts):
        # Initialize with a random state (one queen per column)
        board = [random.randint(0, n - 1) for _ in range(n)]
        curr_conflicts = get_conflicts(board)
       
        while True:
            best_neighbor = list(board)
            best_conflicts = curr_conflicts
           
            # Check all possible single-queen moves (neighbors)
            for col in range(n):
                original_row = board[col]
                for row in range(n):
                    if row == original_row:
                        continue
                   
                    board[col] = row
                    new_conflicts = get_conflicts(board)
                   
                    if new_conflicts < best_conflicts:
                        best_conflicts = new_conflicts
                        best_neighbor = list(board)
               
                board[col] = original_row
           
            # Move if an improvement was found, otherwise stop
            if best_conflicts < curr_conflicts:
                board = best_neighbor
                curr_conflicts = best_conflicts
            else:
                break
       
        # Return immediately if perfect solution is found
        if curr_conflicts == 0:
            print(f"\n✨ Solved on random restart #{restart}! ✨")
            return board
           
    print("\n⚠️ Max restarts reached. Showing the closest solution found.")
    return board

def print_board(board):
    """Prints the board state as a text-based grid."""
    n = len(board)
    print("\n" + "---" * n)
    for row in range(n):
        row_string = ""
        for col in range(n):
            if board[col] == row:
                row_string += " Q "
            else:
                row_string += " . "
        print(row_string)
    print("---" * n)

# --- Execution ---
if __name__ == "__main__":
    try:
        # Ask user for N value
        user_n = int(input("Enter the number of queens (N): "))
       
        if user_n < 4 and user_n != 1:
            print("No solution exists for N = 2 or N = 3. Try 1 or 4+.")
        else:
            solution = hill_climbing_n_queens(user_n)
            print_board(solution)
           
    except ValueError:
        print("Please enter a valid whole number.")



